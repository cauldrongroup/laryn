{
  "name": "@laryn/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Global speech-to-text desktop client for Laryn.",
  "author": "Laryn",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "pnpm build:renderer && pnpm build:electron && node scripts/start-electron.cjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "pnpm build:renderer && pnpm build:electron && cross-env LARYN_WORKER_URL=https://laryn.mineperial.com node scripts/start-electron.cjs",
    "dev:hot": "pnpm build:electron && cross-env LARYN_RENDERER_URL=http://127.0.0.1:5173 LARYN_WORKER_URL=https://laryn.mineperial.com node scripts/dev-electron.cjs",
    "start": "node scripts/start-electron.cjs",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.cjs",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:electron": "pnpm build:main && pnpm build:preload",
    "build": "pnpm build:renderer && pnpm build:electron && electron-builder --dir",
    "dist:win": "pnpm build:renderer && pnpm build:electron && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@laryn/shared": "workspace:*",
    "@vitejs/plugin-react": "^5.0.0",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uiohook-napi": "1.5.5",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "cross-env": "^10.1.0",
    "electron": "^39.8.9",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.2.4"
  },
  "build": {
    "appId": "dev.laryn.desktop",
    "productName": "Laryn",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**",
      "config.cjs",
      "dist/**",
      "dist-electron/**",
      "main.cjs",
      "package.json"
    ],
    "icon": "assets/logo.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "${env.LARYN_UPDATE_BASE_URL}"
      }
    ]
  }
}
