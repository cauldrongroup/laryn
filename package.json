{
  "name": "laryn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Global speech-to-text desktop app backed by Cloudflare Workers AI Gateway.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm desktop:dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "worker:dev": "pnpm --filter @laryn/worker dev",
    "worker:dev:fixed": "pnpm --filter @laryn/worker dev -- --port 8787",
    "worker:dry-run": "node scripts/worker-dry-run.mjs",
    "worker:deploy": "pnpm --filter @laryn/worker run deploy",
    "worker:versions:upload": "pnpm --filter @laryn/worker run versions:upload",
    "desktop:dev": "pnpm --filter @laryn/desktop dev",
    "desktop:dev:renderer": "pnpm --filter @laryn/desktop dev:renderer",
    "desktop:dev:electron": "pnpm --filter @laryn/desktop dev:electron",
    "desktop:dev:hot": "pnpm --filter @laryn/desktop dev:hot",
    "desktop:build": "pnpm --filter @laryn/desktop build",
    "desktop:dist:mac": "pnpm --filter @laryn/desktop dist:mac",
    "desktop:dist:win": "pnpm --filter @laryn/desktop dist:win",
    "security:scan": "node scripts/scan-secrets.mjs"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.27.0",
    "turbo": "^2.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.48.0"
  }
}
